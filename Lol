function F.generateMap(cols, rows, tile, gap, color)
	local parent = State.selected
	if not parent or not (parent:IsA("GuiObject") or parent:IsA("LayerCollector")) then
		parent = State.projectGui
	end
	State.elementCounter = State.elementCounter + 1

	local map = F.new("Frame", {
		Name = "Map" .. State.elementCounter,
		Size = UDim2.fromOffset(cols * (tile + gap) + gap, rows * (tile + gap) + gap),
		Position = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Color3.fromRGB(25, 25, 25),
	})
	F.new("UIPadding", {
		PaddingTop = UDim.new(0, gap), PaddingBottom = UDim.new(0, gap),
		PaddingLeft = UDim.new(0, gap), PaddingRight = UDim.new(0, gap),
		Parent = map,
	})
	F.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(tile, tile),
		CellPadding = UDim2.fromOffset(gap, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = map,
	})

	local light = color:Lerp(Color3.new(1, 1, 1), 0.1)
	local count = 0
	for r = 1, rows do
		for c = 1, cols do
			F.new("Frame", {
				Name = string.format("Tile_%d_%d", r, c),
				BackgroundColor3 = ((r + c) % 2 == 0) and color or light,
				LayoutOrder = (r - 1) * cols + c,
				Parent = map,
			})
			count = count + 1
			if count % 200 == 0 then task.wait() end -- anti-lag
		end
	end

	map.Parent = parent
	State.collapsed[map] = true -- explorer tidak dibanjiri tile
	F.recordAdd(map, parent)
	F.expandAncestors(map)
	F.refreshExplorer()
	F.selectInstance(map)
	return map
end

