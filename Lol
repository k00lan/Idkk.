-- =========================================================================
-- Snapshot + jalankan script untuk Preview
-- =========================================================================
function F.snapshotProject()
	local snap = {}
	for _, c in ipairs(State.projectGui:GetChildren()) do
		if not F.isOverlay(c) then
			local cl = c:Clone()
			if cl then
				table.insert(snap, cl)
				-- source script disalin manual (executor sering melindungi .Source)
				local o, k = { c }, { cl }
				for _, d in ipairs(c:GetDescendants()) do o[#o + 1] = d end
				for _, d in ipairs(cl:GetDescendants()) do k[#k + 1] = d end
				if #o == #k then
					for i = 1, #o do
						if o[i]:IsA("LocalScript") or o[i]:IsA("ModuleScript") then
							F.setScriptSource(k[i], F.getScriptSource(o[i]))
						end
					end
				end
			end
		end
	end
	return snap
end

function F.runPreviewScripts()
	State.previewThreads = {}
	if not State.previewRunScripts or not State.canLoadCode then return end
	for _, d in ipairs(State.projectGui:GetDescendants()) do
		if d:IsA("LocalScript") then
			local src = F.getScriptSource(d)
			if type(src) == "string" and src ~= "" then
				local fn = loadstring(src)
				if fn then
					if typeof(setfenv) == "function" and typeof(getfenv) == "function" then
						pcall(function()
							setfenv(fn, setmetatable({ script = d }, { __index = getfenv(1) }))
						end)
					end
					local th = task.spawn(function()
						local ok, err = pcall(fn)
						if not ok then
							warn("[Preview] " .. d.Name .. ": " .. tostring(err))
						end
					end)
					table.insert(State.previewThreads, th)
				end
			end
		end
	end
end

function F.stopPreviewScripts()
	for _, th in ipairs(State.previewThreads) do
		pcall(task.cancel, th)
	end
	State.previewThreads = {}
end

-- =========================================================================
-- SET MODE
-- =========================================================================
function F.setMode(mode)
	if mode ~= "Edit" and mode ~= "Preview" then return end
	if State.mode == mode and State.modeInitialized then return end
	State.modeInitialized = true
	F.closeActiveDropdown()
	if F.cancelExplorerDrag then F.cancelExplorerDrag() end

	if mode == "Preview" then
		-- bersihkan seleksi dulu supaya overlay/bounding box tidak ikut ke snapshot
		F.clearHighlight()
		F.destroyBoundingBox()
		F.clearAlignmentLines()
		State.selected = nil
		State.selectedSet = {}

		-- GUI game (Mod GUI) tidak disentuh: tanpa snapshot dan tanpa menjalankan script
		local external = State.editingExternalGui ~= nil and State.projectGui == State.editingExternalGui
		State.previewSnapshot = nil
		if not external then
			State.previewSnapshot = F.snapshotProject()
		end

		State.mode = "Preview"
		for _, name in ipairs(State.MODE_TOOL_WINDOWS) do
			local w = UI[name]
			if w then w.Visible = false end
		end
		UI.selectionNameLabel.Visible = false
		UI.optionsButton.Visible = true
		UI.optionsMenu.Visible = true
		pcall(function()
			if State.projectGui:IsA("ScreenGui") then State.projectGui.Enabled = true end
		end)
		if not external then
			F.runPreviewScripts()
		end
	else
		F.stopPreviewScripts()
		State.mode = "Edit"
		if State.previewSnapshot then
			for _, c in ipairs(State.projectGui:GetChildren()) do
				if not F.isOverlay(c) then c:Destroy() end
			end
			for _, cl in ipairs(State.previewSnapshot) do
				cl.Parent = State.projectGui
			end
			State.previewSnapshot = nil
			F.clearHistory()
		end
		State.selected = nil

		-- tombol Options hilang saat Edit
		if State.optionsMenuOpen then
			State.optionsMenuOpen = false
			F.setOptionsMenuSyncing(false)
		end
		UI.optionsMenu.Size = State.optionsMenuMinimizedSize
		UI.optionsMenu.Visible = false
		UI.optionsButton.Visible = false

		pcall(function()
			if State.projectGui:IsA("ScreenGui") then State.projectGui.Enabled = true end
		end)
		F.refreshExplorer()
		F.selectInstance(State.projectGui)
		-- GUI editor diperlihatkan
		if not UI.explorerWindow.Visible then F.showWindowWithFade(UI.explorerWindow) end
		if not UI.propertiesWindow.Visible then F.showWindowWithFade(UI.propertiesWindow) end
	end
	F.refreshModeUi()
end

