-- RESTYLE SEMUA GUI TOOL (sudut bulat, garis tepi aksen, header gradasi)
-- =========================================================================
function F.restyleAllGuis()
	for _, name in ipairs(State.MODE_TOOL_WINDOWS) do
		local w = UI[name]
		if w and w:IsA("GuiObject") then
			if not w:FindFirstChildOfClass("UICorner") then
				F.new("UICorner", { CornerRadius = UDim.new(0, 10), Parent = w })
			end
			local stroke = w:FindFirstChild("__WinStroke")
			if not stroke then
				stroke = F.new("UIStroke", {
					Name = "__WinStroke",
					Thickness = 1,
					Transparency = 0.55,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					Parent = w,
				})
			end
			stroke.Color = State.THEME.Accent
		end
	end
	for _, name in ipairs(State.MODE_TOP_BARS) do
		local bar = UI[name]
		if bar and bar:IsA("GuiObject") then
			if not bar:FindFirstChildOfClass("UICorner") then
				F.new("UICorner", { CornerRadius = UDim.new(0, 10), Parent = bar })
			end
			if not bar:FindFirstChild("__TopGradient") then
				F.new("UIGradient", {
					Name = "__TopGradient",
					Rotation = 90,
					Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(175, 175, 190)),
					Parent = bar,
				})
			end
		end
	end
	if UI.actionBar and not UI.actionBar:FindFirstChildOfClass("UICorner") then
		F.new("UICorner", { CornerRadius = UDim.new(0, 10), Parent = UI.actionBar })
	end
end

