function F.applyClassIcon(imageObject, className)
	local id = State.CLASS_ICON_IDS[className]
	if id then
		imageObject.Image = id
		imageObject.ImageRectOffset = Vector2.new(0, 0)
		imageObject.ImageRectSize = Vector2.new(0, 0)
		return true
	end
	local cell = State.CLASS_ICON_CELLS[className]
	if cell then
		local s = State.CLASS_ICON_CELL
		imageObject.Image = State.CLASS_ICON_ATLAS
		imageObject.ImageRectOffset = Vector2.new(cell[1] * s, cell[2] * s)
		imageObject.ImageRectSize = Vector2.new(s, s)
		return true
	end
	imageObject.Image = ""
	return false
end

