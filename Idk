-- ============================================================================
do
	State.currentMode = "normal" -- "normal" | "edit" | "preview"
	State.savedCharacterState = nil
	State.previewHiddenWindows = {}

	-- Simpan state character
	function F.saveCharacterState(char)
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		State.savedCharacterState = {
			walkSpeed = hum and hum.WalkSpeed or 16,
			jumpPower = hum and hum.JumpPower or 50,
			jumpHeight = hum and hum.JumpHeight or 7.2,
			anchored = hrp and hrp.Anchored or false,
		}
	end

	function F.restoreCharacterState(char)
		if not char or not State.savedCharacterState then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hum then
			hum.WalkSpeed = State.savedCharacterState.walkSpeed
			hum.JumpPower = State.savedCharacterState.jumpPower
			hum.JumpHeight = State.savedCharacterState.jumpHeight
		end
		if hrp then
			hrp.Anchored = State.savedCharacterState.anchored
		end
		State.savedCharacterState = nil
	end

	-- Sembunyikan avatar (via LocalTransparencyModifier, hanya lokal)
	function F.setAvatarVisibility(char, hidden)
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
				pcall(function()
					part.LocalTransparencyModifier = hidden and 1 or 0
				end)
			end
		end
	end

	function F.applyEditMode()
		local char = LocalPlayer.Character
		if not char then return end
		F.saveCharacterState(char)

		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")

		if hum then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.JumpHeight = 0
		end
		if hrp then
			hrp.Anchored = true
		end
		F.setAvatarVisibility(char, true)
	end

	function F.removeEditMode()
		local char = LocalPlayer.Character
		if not char then return end
		F.restoreCharacterState(char)
		F.setAvatarVisibility(char, false)
	end

	function F.applyPreviewMode()
		State.previewHiddenWindows = {}

		local windows = {
			UI.explorerWindow, UI.propertiesWindow, UI.settingsWindow,
			UI.saveLoadWindow, UI.importWindow, UI.gui2luaWindow,
			UI.codeOutputWindow, UI.sourceEditorWindow, UI.modGuiWindow,
			UI.addElementPopup, UI.optionsMenu, UI.saveNamePopup,
			UI.downloadWindow, UI.colorPickerWindow, UI.gradientEditorWindow,
		}
		for _, w in ipairs(windows) do
			if w then
				State.previewHiddenWindows[w] = w.Visible
				w.Visible = false
			end
		end

		if UI.optionsButton then
			State.previewHiddenWindows[UI.optionsButton] = UI.optionsButton.Visible
			UI.optionsButton.Visible = false
		end
		if UI.selectionNameLabel then
			UI.selectionNameLabel.Visible = false
		end

		F.destroyBoundingBox()
		F.clearAlignmentLines()
		F.clearHighlight()
	end

	function F.removePreviewMode()
		for w, vis in pairs(State.previewHiddenWindows) do
			if w and w.Parent then
				w.Visible = vis
			end
		end
		State.previewHiddenWindows = {}
	end

	function F.setMode(mode)
		if State.currentMode == mode then return end

		-- Bersihkan mode sebelumnya
		if State.currentMode == "edit" then
			F.removeEditMode()
		elseif State.currentMode == "preview" then
			F.removePreviewMode()
		end

		State.currentMode = mode

		if mode == "edit" then
			F.applyEditMode()
		elseif mode == "preview" then
			F.applyPreviewMode()
		end

		F.refreshModeButtons()
	end

	function F.refreshModeButtons()
		if not UI.editModeBtn or not UI.previewModeBtn then return end
		local editOn = State.currentMode == "edit"
		local previewOn = State.currentMode == "preview"

		UI.editModeBtn.BackgroundColor3 = editOn and State.THEME.Accent or State.THEME.Button
		UI.editModeBtn.TextColor3 = editOn and Color3.fromRGB(255, 255, 255) or State.THEME.Text
		UI.editModeBtn.Text = editOn and "Edit Mode: ON" or "Edit Mode: OFF"

		UI.previewModeBtn.BackgroundColor3 = previewOn and State.THEME.Accent or State.THEME.Button
		UI.previewModeBtn.TextColor3 = previewOn and Color3.fromRGB(255, 255, 255) or State.THEME.Text
		UI.previewModeBtn.Text = previewOn and "Preview Mode: ON" or "Preview Mode: OFF"
	end

	-- Tombol Edit Mode di options menu
	UI.editModeBtn = F.menuButton(7, "Edit Mode", State.ICONS.EditMode)
	if UI.editModeBtn then
		for _, d in ipairs(UI.editModeBtn:GetDescendants()) do
			if d:IsA("TextLabel") then
				d.Position = UDim2.new(0, 34, 0, 0)
				d.Size = UDim2.new(1, -40, 1, 0)
			end
		end
		UI.editModeBtn.MouseButton1Click:Connect(function()
			if State.currentMode == "edit" then
				F.setMode("normal")
			else
				F.setMode("edit")
			end
		end)
	end

	-- Tombol Preview Mode
	UI.previewModeBtn = F.menuButton(8, "Preview Mode", State.ICONS.PreviewMode)
	if UI.previewModeBtn then
		for _, d in ipairs(UI.previewModeBtn:GetDescendants()) do
			if d:IsA("TextLabel") then
				d.Position = UDim2.new(0, 34, 0, 0)
				d.Size = UDim2.new(1, -40, 1, 0)
			end
		end
		UI.previewModeBtn.MouseButton1Click:Connect(function()
			if State.currentMode == "preview" then
				F.setMode("normal")
			else
				F.setMode("preview")
			end
		end)
	end

	-- Re-freeze kalau respawn saat Edit Mode aktif
	LocalPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.5)
		if State.currentMode == "edit" then
			F.applyEditMode()
		end
	end)

	-- Update tinggi options menu (sekarang 8 tombol)
	State.OPTIONS_MENU_HEIGHT = 8 * 38 + 16
	State.optionsMenuOriginalSize = UDim2.new(0, 180, 0, State.OPTIONS_MENU_HEIGHT)
	State.optionsMenuMinimizedSize = UDim2.new(0, 180, 0, 0)
	if UI.optionsMenuList then
		UI.optionsMenuList.Size = UDim2.new(1, -12, 0, State.OPTIONS_MENU_HEIGHT - 12)
	end

	F.refreshModeButtons()
end -- do (MODE EDIT & PREVIEW)

